# FDR-Sentinel Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=production

# JWT Authentication Secret Key (Replace with a cryptographically strong 256-bit secret in production)
JWT_SECRET=aicte-fdr-sentinel-dev-secret-key-change-in-production-123456

# Database File Path (SQLite)
DB_PATH=./fdr_sentinel.db

# Storage Directory for Uploaded Documents & Certificates
UPLOAD_DIR=./uploads

# Demo Clock Feature (Enables time-travel for SIH demonstration and testing)
ENABLE_DEMO_CLOCK=true
