{
  "name": "fdr-sentinel",
  "version": "1.0.0",
  "description": "FDR-Sentinel: Security Deposit / FDR Management Portal for AICTE Regulation Bureau",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "seed": "npm --prefix server run seed",
    "benchmark": "npm --prefix server run benchmark",
    "verify": "npm --prefix server run verify"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vercel/node": "^5.1.8",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
